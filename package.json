    "mermaid": "^11.17.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.11",
